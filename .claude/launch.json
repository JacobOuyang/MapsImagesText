{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "simulator",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "sim/server.py"
      ],
      "port": 8765,
      "url": "http://127.0.0.1:8765"
    },
    {
      "name": "eval-pages",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "out/eval"
      ],
      "port": 8766,
      "url": "http://127.0.0.1:8766"
    },
    {
      "name": "whatsapp",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "sim/whatsapp_server.py"
      ],
      "port": 8770,
      "url": "http://127.0.0.1:8770"
    },
    {
      "name": "smuse",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "sim/smuse.py"
      ],
      "port": 8780,
      "url": "http://127.0.0.1:8780"
    }
  ]
}
