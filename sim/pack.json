{"version":1,"entries":[{"id":"01","task":"close the valve on a propane tank","step":"Turn tank valve right (clockwise) if safe to reach.","item":"propane tank valve with round handwheel on top","before":"","after":""},{"id":"02","task":"reset a GFCI outlet","step":"Plug nightlight in and turn nightlight on.","item":"nightlight plug in GFCI outlet","before":"","after":""},{"id":"03","task":"shut off the gas at the meter","step":"Wrench valve quarter turn to crosswise to close line.","item":"meter shutoff valve on gas pipe","before":"","after":""},{"id":"04","task":"shut off the water to a toilet","step":"Turn valve clockwise to stop water flow.","item":"shutoff valve on wall behind toilet","before":"","after":""},{"id":"05","task":"switch off the electricity at the breaker panel","step":"Switch individual breakers off, then main off.","item":"individual circuit breaker toggle on panel","before":"","after":""},{"id":"06","task":"switch off the electricity at the breaker panel","step":"For fuse box, pull out the 2 main cartridge fuses.","item":"main cartridge fuse in fuse box","before":"","after":""},{"id":"07","task":"turn off a space heater","step":"Switch heater power to off position.","item":"heater power switch","before":"","after":""},{"id":"08","task":"turn off a space heater","step":"Unplug heater from wall outlet.","item":"heater plug in wall outlet","before":"","after":""},{"id":"09","task":"turn off the main water shut-off valve","step":"Turn lever 1/4 turn across pipe until it stops.","item":"lever valve on pipe","before":"","after":""},{"id":"10","task":"turn on an AED","step":"Turn on AED when available, follow voice prompts","item":"AED unit","before":"","after":""},{"id":"11","task":"turn on an AED","step":"Say CLEAR, push shock button if needed","item":"shock button on AED unit","before":"","after":""},{"id":"12","task":"use a fire extinguisher","step":"Pull pin, aim nozzle low at base of fire.","item":"extinguisher top with safety pin","before":"","after":""},{"id":"13","task":"use a fire extinguisher","step":"Squeeze handle slowly to release agent.","item":"extinguisher squeeze handle","before":"","after":""},{"id":"14","task":"use an EpiPen","step":"Grip middle, blue cap up; pull off blue safety cap.","item":"blue safety cap on EpiPen","before":"","after":""}]}